@startuml as-is-layered-overview
' =====================================================================
' Ofgem - 8x8 Telephony Solution with Creovai
' As-Is High-Level Design - ArchiMate Layered Overview
' Notation: ArchiMate 3.x (PlantUML archimate standard library)
' =====================================================================
!include <archimate/Archimate>

title As-Is HLD - Ofgem 8x8 Telephony Solution with Creovai (Layered Overview)

' Layers used (standard ArchiMate palette):
'   Business    = yellow
'   Application = blue
'   Technology  = green

' ---------------------------------------------------------------------
' BUSINESS LAYER
' ---------------------------------------------------------------------
Business_Actor(delivery, "Delivery & Schemes")
Business_Actor(servicedesk, "IT Service Desk")
Business_Service(telephonySvc, "Telephony & Contact\nCentre Service")
Business_Function(outbound, "Outbound Calling\n(scheme follow-ups)")
Business_Function(inbound, "Inbound Call Handling")

' ---------------------------------------------------------------------
' APPLICATION LAYER
' ---------------------------------------------------------------------
' Access channels
Application_Component(desktopApp, "8x8 Desktop App\n(softphone)")
Application_Component(webClient, "8x8 Web Browser Client")
Application_Component(teams, "Microsoft Teams\n(8x8 integration)")

' Core platform (System of Record)
Application_Component(eightByEight, "8x8 Contact Centre Platform\n<<System of Record>>")
Application_Function(callHandling, "Call Handling\n(inbound / outbound / voicemail)")
Application_Function(recording, "Call Recording")
Application_DataObject(callData, "Telephony Data\n(calls, recordings, metadata)")

' Downstream analytics
Application_Component(creovai, "Creovai\n<<Downstream Analytics>>")
Application_Function(convIntel, "Conversation Intelligence")
Application_Function(agentGuide, "Agent Guidance")
Application_DataObject(outputs, "Dashboards & JSON / API Outputs")

' ---------------------------------------------------------------------
' TECHNOLOGY / IDENTITY LAYER
' ---------------------------------------------------------------------
Technology_SystemSoftware(entra, "Microsoft Entra ID\n(SSO Authentication)")
Technology_Node(secGroups, "Entra Security Groups\n(controlled user enablement)")

' ---------------------------------------------------------------------
' RELATIONSHIPS
' ---------------------------------------------------------------------
' Business uses telephony service
Rel_Assignment(delivery, telephonySvc, "")
Rel_Assignment(servicedesk, telephonySvc, "")
Rel_Composition(telephonySvc, outbound, "")
Rel_Composition(telephonySvc, inbound, "")

' Access channels serve the business / realise the service
Rel_Serving(desktopApp, telephonySvc, "")
Rel_Serving(webClient, telephonySvc, "")
Rel_Serving(teams, telephonySvc, "")

' Channels connect to the core platform
Rel_Serving(eightByEight, desktopApp, "")
Rel_Serving(eightByEight, webClient, "")
Rel_Serving(eightByEight, teams, "telephony in Teams\n(enabled users only)")

' Core platform internals
Rel_Composition(eightByEight, callHandling, "")
Rel_Composition(eightByEight, recording, "")
Rel_Access(callHandling, callData, "")
Rel_Access(recording, callData, "")

' Single, controlled integration path: 8x8 <-> Creovai
Rel_Flow(eightByEight, creovai, "HTTPS / JSON\n(real-time + batch)")
Rel_Composition(creovai, convIntel, "")
Rel_Composition(creovai, agentGuide, "")
Rel_Realization(creovai, outputs, "")

' Identity governs access to 8x8 and Teams ONLY
Rel_Serving(entra, eightByEight, "SSO")
Rel_Serving(entra, teams, "SSO")
Rel_Assignment(secGroups, entra, "")

note bottom of callData
  Principle: 8x8 is the single system of record
  for telephony, recordings & metadata.
end note

@enduml
