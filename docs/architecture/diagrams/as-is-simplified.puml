@startuml as-is-simplified
' =====================================================================
' Ofgem - 8x8 Telephony Solution with Creovai
' As-Is - SIMPLIFIED view (per review feedback):
'   "Take the as-is diagram and have the three Creovai boxes down the
'    bottom with one arrow into / out of 8x8."
' Single, controlled integration chain - no branching via Azure.
' =====================================================================
!include <archimate/Archimate>

title As-Is (Simplified) - 8x8 Telephony Solution with Creovai

' --- Access channels (top) ---
Application_Component(desktopApp, "8x8 Desktop App\n(softphone)")
Application_Component(webClient, "Web Browser")
Application_Component(teams, "Microsoft Teams\n(integration)")

' --- Identity (governs access to 8x8 & Teams only) ---
Technology_SystemSoftware(entra, "Microsoft Entra ID\n(SSO + Security Groups)")

' --- Core platform (centre) ---
Application_Component(eightByEight, "8x8\nContact Centre Platform\n<<System of Record>>")

' --- Creovai: three boxes at the bottom ---
Application_Component(convIntel, "Creovai:\nConversation Intelligence")
Application_Component(agentGuide, "Creovai:\nAgent Guidance")
Application_Component(outputs, "Creovai:\nDashboards & API Outputs")

' --- Access into 8x8 ---
Rel_Serving(desktopApp, eightByEight, "")
Rel_Serving(webClient, eightByEight, "")
Rel_Serving(teams, eightByEight, "")

' --- Identity governs access to 8x8 and Teams ONLY (not Creovai) ---
Rel_Serving(entra, eightByEight, "SSO")
Rel_Serving(entra, teams, "SSO")

' --- ONE controlled arrow into / out of 8x8 -> Creovai ---
Rel_Flow(eightByEight, convIntel, "HTTPS / JSON")

' --- Creovai single-chain: 8x8 -> Creovai -> Outputs ---
Rel_Flow(convIntel, agentGuide, "")
Rel_Flow(agentGuide, outputs, "")

@enduml
