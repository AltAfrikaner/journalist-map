<?xml version="1.0" encoding="utf-8"?>
<!--
  AI SoundStripper - SELF-CONTAINED Windows Installer (MSI) source.

  Unlike aisoundstripper.wxs (which installs the Python script and needs
  Python on the target), this packages the PyInstaller one-file executable
  AISoundStripper.exe, which bundles the Python runtime. The target machine
  needs NOTHING preinstalled.

  Build pipeline (see build_standalone_msi.bat / .sh):
    1. Build a one-file windowed exe with PyInstaller, icon = aisoundstripper.ico,
       name = AISoundStripper, from ../provenance.py.
    2a. Windows (WiX v3):  candle then light on this file.
    2b. Linux/macOS:       wixl -o AISoundStripper-Standalone.msi this file.

  Expects the built exe at: dist/AISoundStripper.exe  (relative to this file).
  Still a METADATA cleaner, not a watermark remover.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="AI SoundStripper"
           Language="1033"
           Version="1.0.0"
           Manufacturer="AI SoundStripper"
           UpgradeCode="3C40D420-2218-4B6E-AF0F-2DB5C102DD78">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Manufacturer="AI SoundStripper"
             Description="AI SoundStripper (standalone) - audio provenance inspector and Layer-1 metadata cleaner"
             Comments="Self-contained; bundles Python. Metadata cleaner only." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of AI SoundStripper is already installed." />
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

    <Icon Id="aisoundstripper.ico" SourceFile="aisoundstripper.ico" />
    <Property Id="ARPPRODUCTICON" Value="aisoundstripper.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="AI SoundStripper">

          <Component Id="C_App" Guid="9C7E7127-B7D8-4F4E-B888-FEBC72478DBE">
            <File Id="AISoundStripper.exe" Name="AISoundStripper.exe"
                  Source="dist/AISoundStripper.exe" KeyPath="yes">
              <!-- Advertised shortcuts that live with the exe itself. -->
              <Shortcut Id="StartMenuShortcut"
                        Directory="AppMenuDir"
                        Name="AI SoundStripper"
                        WorkingDirectory="INSTALLDIR"
                        Icon="aisoundstripper.ico"
                        IconIndex="0"
                        Advertise="yes"
                        Description="Inspect AI provenance and strip container metadata" />
              <Shortcut Id="DesktopShortcut"
                        Directory="DesktopFolder"
                        Name="AI SoundStripper"
                        WorkingDirectory="INSTALLDIR"
                        Icon="aisoundstripper.ico"
                        IconIndex="0"
                        Advertise="yes"
                        Description="Inspect AI provenance and strip container metadata" />
            </File>
            <File Id="README.md" Name="README.md" Source="../README.md" />
          </Component>

        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuDir" Name="AI SoundStripper">
          <Component Id="C_StartMenu" Guid="2A6AB347-4078-43AF-972B-9EC968E6C075">
            <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\AISoundStripper"
                           Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" />
    </Directory>

    <Feature Id="MainFeature" Title="AI SoundStripper" Level="1">
      <ComponentRef Id="C_App" />
      <ComponentRef Id="C_StartMenu" />
    </Feature>

  </Product>
</Wix>
