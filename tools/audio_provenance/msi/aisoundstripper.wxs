<?xml version="1.0" encoding="utf-8"?>
<!--
  AI SoundStripper - Windows Installer (MSI) source.

  Builds with wixl (msitools) on Linux OR candle/light (WiX) on Windows:
      wixl -o AISoundStripper.msi aisoundstripper.wxs \
           -D SourceDir=. -D EngineDir=..

  Installs the provenance engine + launchers to "Program Files\AI SoundStripper",
  adds that folder to the system PATH (so `soundstrip` works in any terminal),
  and creates Start Menu + Desktop shortcuts to the click-to-run window.

  NOTE: this installs the Python engine and requires Python 3 on the target
  machine (the launchers detect it and prompt if missing). It is a METADATA
  cleaner, not a watermark remover.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="AI SoundStripper"
           Language="1033"
           Version="1.0.0"
           Manufacturer="AI SoundStripper"
           UpgradeCode="48616F64-E600-4E60-B880-287244DB54EF">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Manufacturer="AI SoundStripper"
             Description="AI SoundStripper - audio provenance inspector and Layer-1 metadata cleaner"
             Comments="Metadata cleaner only; does not remove signal watermarks or model fingerprints." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of AI SoundStripper is already installed." />
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

    <!-- Branded icon: used for shortcuts and the Add/Remove Programs entry. -->
    <Icon Id="aisoundstripper.ico" SourceFile="aisoundstripper.ico" />
    <Property Id="ARPPRODUCTICON" Value="aisoundstripper.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="AI SoundStripper">

          <Component Id="C_Engine" Guid="3E4A4AC3-178A-467D-921D-58B85C84817E">
            <File Id="provenance.py" Name="provenance.py" Source="../provenance.py" KeyPath="yes" />
            <File Id="README.md"     Name="README.md"     Source="../README.md" />
          </Component>

          <Component Id="C_Launchers" Guid="7179218E-0824-45F0-9DA8-87DA02AF09E9">
            <File Id="AISoundStripper.vbs" Name="AISoundStripper.vbs" Source="AISoundStripper.vbs" KeyPath="yes" />
            <File Id="soundstrip.cmd"      Name="soundstrip.cmd"      Source="soundstrip.cmd" />
          </Component>

        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuDir" Name="AI SoundStripper">
          <Component Id="C_StartMenu" Guid="03076862-A2E8-4110-B943-B42F75E1CF98">
            <Shortcut Id="StartMenuShortcut"
                      Name="AI SoundStripper"
                      Target="[INSTALLDIR]AISoundStripper.vbs"
                      WorkingDirectory="INSTALLDIR"
                      Icon="aisoundstripper.ico"
                      IconIndex="0"
                      Description="Inspect AI provenance and strip container metadata" />
            <RemoveFolder Id="RemoveAppMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\AISoundStripper"
                           Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder">
        <Component Id="C_Desktop" Guid="4622601D-F836-4714-BB8B-3CD41A4661FD">
          <Shortcut Id="DesktopShortcut"
                    Name="AI SoundStripper"
                    Target="[INSTALLDIR]AISoundStripper.vbs"
                    WorkingDirectory="INSTALLDIR"
                    Icon="aisoundstripper.ico"
                    IconIndex="0"
                    Description="Inspect AI provenance and strip container metadata" />
          <RegistryValue Root="HKCU" Key="Software\AISoundStripper"
                         Name="desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="AI SoundStripper" Level="1">
      <ComponentRef Id="C_Engine" />
      <ComponentRef Id="C_Launchers" />
      <ComponentRef Id="C_StartMenu" />
      <ComponentRef Id="C_Desktop" />
    </Feature>

  </Product>
</Wix>
